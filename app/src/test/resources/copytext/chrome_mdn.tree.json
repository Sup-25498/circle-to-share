ers and creates a new array containing the square roots of the numbers in the first array.","w":true,"r":"paragraph"},{"c":"TextView","b":[78,2577,126,2577],"t":"JS","w":true,"r":"staticText"},{"c":"View","b":[39,2577,1242,2577],"t":"const numbers = [1, 4, 9];\nconst roots = numbers.map((num) => Math.sqrt(num));\n\n// roots is now     [1, 2, 3]\n// numbers is still [1, 4, 9]\n","w":true,"r":"code"}]},{"c":"View","b":[36,2577,1242,2577],"t":"","w":true,"r":"region","d":"region","k":[{"c":"View","b":[36,2577,1242,2577],"t":"Using map to reformat objects in an array","h":true,"w":true,"r":"heading","d":"heading link","k":[{"c":"View","b":[36,2577,1152,2577],"w":true,"r":"link","d":"heading link","k":[{"c":"TextView","b":[36,2577,1113,2577],"t":"Using map to reformat objects in an array","w":true,"r":"staticText"}]}]},{"c":"TextView","b":[36,2577,1242,2577],"t":"The following code takes an array of objects and creates a new array containing the newly reformatted objects.","w":true,"r":"paragraph"},{"c":"TextView","b":[78,2577,126,2577],"t":"JS","w":true,"r":"staticText"},{"c":"View","b":[39,2577,1242,2577],"t":"const kvArray = [\n  { key: 1, value: 10 },\n  { key: 2, value: 20 },\n  { key: 3, value: 30 },\n];\n\nconst reformattedArray = kvArray.map(({ key, value }) => ({ [key]: value }));\n\nconsole.log(reformattedArray); // [{ 1: 10 }, { 2: 20 }, { 3: 30 }]\nconsole.log(kvArray);\n// [\n//   { key: 1, value: 10 },\n//   { key: 2, value: 20 },\n//   { key: 3, value: 30 }\n// ]\n","w":true,"r":"code"}]},{"c":"View","b":[36,2577,1242,2577],"t":"","w":true,"r":"region","d":"region","k":[{"c":"View","b":[36,2577,1242,2577],"t":"Using parseInt() with map()","h":true,"w":true,"r":"heading","d":"heading link","k":[{"c":"View","b":[36,2577,792,2577],"w":true,"r":"link","d":"heading link","k":[{"c":"TextView","b":[36,2577,753,2577],"t":"Using parseInt() with map()","w":true,"r":"staticText"}]}]},{"c":"TextView","b":[36,2577,1242,2577],"t":"It is common to use the callback with o