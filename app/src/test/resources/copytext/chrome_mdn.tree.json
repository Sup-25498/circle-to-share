 index) => {\n  if (index < 3) {\n    return num;\n  }\n});\n\n// index goes from 0, so the filteredNumbers are 1,2,3 and undefined.\n// filteredNumbers is [1, 2, 3, undefined]\n// numbers is still [1, 2, 3, 4]\n","w":true,"r":"code"}]},{"c":"View","b":[36,2577,1242,2577],"t":"","w":true,"r":"region","d":"region","k":[{"c":"View","b":[36,2577,1242,2577],"t":"Side-effectful mapping","h":true,"w":true,"r":"heading","d":"heading link","k":[{"c":"View","b":[36,2577,678,2577],"w":true,"r":"link","d":"heading link","k":[{"c":"TextView","b":[36,2577,636,2577],"t":"Side-effectful mapping","w":true,"r":"staticText"}]}]},{"c":"TextView","b":[36,2577,1242,2577],"t":"The callback can have side effects.","w":true,"r":"paragraph"},{"c":"TextView","b":[78,2577,126,2577],"t":"JS","w":true,"r":"staticText"},{"c":"View","b":[39,2577,1242,2577],"t":"const cart = [5, 15, 25];\nlet total = 0;\nconst withTax = cart.map((cost) => {\n  total += cost;\n  return cost * 1.2;\n});\nconsole.log(withTax); // [6, 18, 30]\nconsole.log(total); // 45\n","w":true,"r":"code"},{"c":"TextView","b":[36,2577,1242,2577],"t":"This is not recommended, because copying methods are best used with pure functions. In this case, we can choose to iterate the array twice.","w":true,"r":"paragraph"},{"c":"TextView","b":[78,2577,126,2577],"t":"JS","w":true,"r":"staticText"},{"c":"View","b":[39,2577,1242,2577],"t":"const cart = [5, 15, 25];\nconst total = cart.reduce((acc, cost) => acc + cost, 0);\nconst withTax = cart.map((cost) => cost * 1.2);\n","w":true,"r":"code"},{"c":"View","b":[36,2577,1242,2577],"t":"","w":true,"r":"paragraph","k":[{"c":"TextView","b":[36,2577,966,2577],"t":"Sometimes this pattern goes to its extreme and the ","w":true,"r":"staticText"},{"c":"View","b":[963,2577,1041,2577],"t":"only","w":true,"r":"emphasis"},{"c":"TextView","b":[36,2577,1164,2577],"t":" useful thing that ","w":true,"r":"staticText"},{"c":"View","b":[216,2577,348,2577],"t":"map()","w":true,"r":"code"},{"c":"TextView","b":[345,2